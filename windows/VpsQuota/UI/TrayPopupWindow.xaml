<Window x:Class="VpsQuota.UI.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VpsQuota.UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <!-- 外层 Margin 是留给投影的：AllowsTransparency 的窗口不会自动扩出阴影空间 -->
    <Border Width="336" Margin="14" Padding="13" CornerRadius="12"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.20" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <DockPanel Margin="0,0,0,9">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="VPS 流量" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </DockPanel>

            <Border Height="1" Background="#EEF2F7" Margin="0,0,0,4"/>

            <!-- 服务器一多，SizeToContent 的窗口会一路长到屏幕外，这里封顶后内部滚动 -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:ServerRowViewModel}">
                        <StackPanel Margin="0,8,0,4">
                            <DockPanel>
                                <TextBlock Text="{Binding RemainingText}" DockPanel.Dock="Right"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{Binding AccentBrush}"/>
                                <TextBlock Text="📌" FontSize="11" Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           ToolTip="托盘图标显示的就是这一台"
                                           Visibility="{Binding PinnedVisibility}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <ProgressBar Height="6" Margin="0,6" Minimum="0" Maximum="1"
                                         Value="{Binding Fraction, Mode=OneWay}"
                                         Foreground="{Binding AccentBrush}"
                                         Background="#E8EDF4" BorderThickness="0"/>

                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding UsageText}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding PeriodText}"/>
                            <TextBlock FontSize="11" Foreground="#E03B33" TextWrapping="Wrap"
                                       MaxHeight="34" Text="{Binding ErrorText}"
                                       Visibility="{Binding ErrorVisibility}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyPanel" Margin="0,10,0,6" Visibility="Collapsed">
                <TextBlock Text="还没有配置服务器" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="在设置里添加 Vultr 实例或可 SSH 登录的服务器后即可开始监控。"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <TextBlock x:Name="FatalText" FontSize="12" Foreground="#E03B33" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>

            <Border Height="1" Background="#EEF2F7" Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="打开主界面" Padding="11,6" FontSize="12" Click="OnOpenMainClick"/>
                <Button x:Name="RefreshButton" Content="立即刷新" Padding="11,6" FontSize="12"
                        Margin="7,0,0,0" Click="OnRefreshClick"/>
                <Button Content="设置" Padding="11,6" FontSize="12" Margin="7,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="OnSettingsClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
