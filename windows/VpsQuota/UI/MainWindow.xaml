<Window x:Class="VpsQuota.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VpsQuota.UI"
        Title="VPS 流量" Height="620" Width="880"
        MinHeight="480" MinWidth="720"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Content="立即刷新" Padding="12,5"
                    Click="OnRefreshClick"/>
            <Button x:Name="SettingsButton" Content="设置…" Padding="12,5" Margin="8,0,0,0"
                    Click="OnSettingsClick"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="Gray" FontSize="12"/>
        </DockPanel>

        <!-- 左栏：服务器列表 -->
        <ListBox x:Name="ServerList" Grid.Row="1" Grid.Column="0"
                 BorderThickness="1" BorderBrush="#E5E5E5"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnServerSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:ServerRowViewModel}">
                    <StackPanel Margin="4,7">
                        <DockPanel>
                            <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Right"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{Binding AccentBrush}"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <!-- 用内置 ProgressBar：宽度换算交给它，省掉一个自制转换器 -->
                        <ProgressBar Height="6" Margin="0,5"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding Fraction, Mode=OneWay}"
                                     Foreground="{Binding AccentBrush}"
                                     Background="#EDEDED" BorderThickness="0"/>

                        <TextBlock Text="{Binding UsageText}" FontSize="11" Foreground="#666"/>
                        <TextBlock Text="{Binding PeriodText}" FontSize="11" Foreground="#999"/>
                        <TextBlock Text="{Binding ErrorText}" FontSize="10" Foreground="#E03B33"
                                   TextWrapping="Wrap" MaxHeight="34"
                                   Visibility="{Binding ErrorVisibility}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 右栏：详情 -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" x:Name="DetailPanel" Margin="0,0,0,12">
                <TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="DetailUsed" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailQuota" FontSize="13" Foreground="Gray"
                               VerticalAlignment="Bottom" Margin="8,0,0,5"/>
                </StackPanel>
                <TextBlock x:Name="DetailPeriod" FontSize="12" Foreground="#666" Margin="0,6,0,0"/>
                <TextBlock x:Name="DetailProjection" FontSize="12" Margin="0,3,0,0"/>
                <TextBlock x:Name="DetailMeter" FontSize="12" Foreground="#666" Margin="0,3,0,0"/>
                <TextBlock x:Name="DetailLastSuccess" FontSize="11" Foreground="#999" Margin="0,3,0,0"/>
                <TextBlock x:Name="DetailWarning" FontSize="11" Foreground="#F28B21"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock x:Name="DetailError" FontSize="11" Foreground="#E03B33"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#E5E5E5" BorderThickness="1">
                <ui:TrendChart x:Name="Chart"/>
            </Border>
        </Grid>
    </Grid>
</Window>
