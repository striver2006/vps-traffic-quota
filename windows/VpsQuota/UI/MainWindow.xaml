<Window x:Class="VpsQuota.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VpsQuota.UI"
        Title="VPS 流量" Height="650" Width="930"
        MinHeight="500" MinWidth="760"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部品牌区 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="立即刷新" Padding="13,7"
                            Click="OnRefreshClick"/>
                    <Button x:Name="SettingsButton" Content="设置" Padding="13,7" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="OnSettingsClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/app-icon.png" Width="38" Height="38"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="VPS 流量监控" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="集中查看 DMIT 与 Vultr 的月度配额、剩余空间和月末外推"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="22,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 左栏：服务器列表 -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="服务器" Style="{StaticResource SectionTitle}" Margin="6,0,0,9"/>
                <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnServerSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:ServerRowViewModel}">
                            <Border x:Name="ItemShell" Padding="10,9" CornerRadius="8"
                                    Background="Transparent" Margin="0,2">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding PercentText}" DockPanel.Dock="Right"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <ProgressBar Height="7" Margin="0,6" Minimum="0" Maximum="1"
                                                 Value="{Binding Fraction, Mode=OneWay}"
                                                 Foreground="{Binding AccentBrush}"
                                                 Background="#E8EDF4" BorderThickness="0"/>

                                    <TextBlock Text="{Binding UsageText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PeriodText}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="#E03B33"
                                               TextWrapping="Wrap" MaxHeight="34"
                                               Visibility="{Binding ErrorVisibility}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="ItemShell" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EAF2FF" Offset="0"/>
                                                <GradientStop Color="#F4EBFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右栏：详情与趋势 -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" x:Name="DetailPanel">
                        <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock x:Name="DetailUsed" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="DetailQuota" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailPeriod" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="DetailProjection" FontSize="13" Margin="0,4,0,0"/>
                        <TextBlock x:Name="DetailMeter" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="DetailWarning" FontSize="12" Foreground="#F28B21"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailError" FontSize="12" Foreground="#E03B33"
                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="DetailLastSuccess" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="账期内每日趋势" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,8"/>
                    <ui:TrendChart Grid.Row="1" x:Name="Chart"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
