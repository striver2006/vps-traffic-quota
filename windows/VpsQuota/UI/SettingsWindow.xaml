<Window x:Class="VpsQuota.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="820"
        MinHeight="500" MinWidth="740"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="White"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：服务器列表 + 增删 -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="添加 Vultr" Padding="8,4" Click="OnAddVultrClick"/>
                <Button Content="添加 SSH" Padding="8,4" Margin="6,0,0,0" Click="OnAddSshClick"/>
                <Button x:Name="RemoveButton" Content="删除" Padding="8,4" Margin="6,0,0,0"
                        Click="OnRemoveClick"/>
            </StackPanel>
            <ListBox x:Name="ServerList" BorderBrush="#E5E5E5" BorderThickness="1"
                     SelectionChanged="OnSelectionChanged"/>
        </DockPanel>

        <!-- 右栏：通用设置 + 选中服务器的编辑表单 -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="14,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="通用" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                <TextBlock Text="Vultr API Key" FontSize="12"/>
                <PasswordBox x:Name="ApiKeyBox" Padding="4" Margin="0,3,0,3"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#777" Margin="0,0,0,10"
                           Text="在 Vultr 后台 Account → API 页面创建。该页面默认启用访问控制，需要把你当前的出口 IP 加入允许列表，否则会返回 403。密钥用 Windows DPAPI 以当前用户身份加密保存，不写入配置文件。"/>

                <TextBlock Text="自动刷新" FontSize="12"/>
                <ComboBox x:Name="IntervalBox" Margin="0,3,0,3" SelectedValuePath="Tag">
                    <ComboBoxItem Content="每 15 分钟" Tag="15"/>
                    <ComboBoxItem Content="每小时" Tag="60"/>
                    <ComboBoxItem Content="每 6 小时" Tag="360"/>
                    <ComboBoxItem Content="每天" Tag="1440"/>
                </ComboBox>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#777" Margin="0,0,0,14"
                           Text="Vultr 的带宽数据本身是周期性刷新的，并非实时，刷新过于频繁没有意义。"/>

                <Separator Margin="0,0,0,14"/>

                <StackPanel x:Name="ServerPanel" Visibility="Collapsed">
                    <TextBlock Text="服务器" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                    <TextBlock Text="名称" FontSize="12"/>
                    <TextBox x:Name="NameBox" Padding="4" Margin="0,3,0,8"/>

                    <!-- Vultr 专用 -->
                    <StackPanel x:Name="VultrPanel">
                        <TextBlock Text="Vultr 实例 ID" FontSize="12"/>
                        <TextBox x:Name="InstanceIdBox" Padding="4" Margin="0,3,0,3"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#777" Margin="0,0,0,8"
                                   Text="在 Vultr 实例页面的 URL 里可以找到。"/>
                    </StackPanel>

                    <!-- SSH 专用 -->
                    <StackPanel x:Name="SshPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="主机" FontSize="12"/>
                                <TextBox x:Name="HostBox" Padding="4" Margin="0,3,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="端口" FontSize="12"/>
                                <TextBox x:Name="PortBox" Padding="4" Margin="0,3,0,8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="用户名" FontSize="12"/>
                        <TextBox x:Name="UserBox" Padding="4" Margin="0,3,0,8"/>

                        <TextBlock Text="私钥路径" FontSize="12"/>
                        <TextBox x:Name="KeyPathBox" Padding="4" Margin="0,3,0,8"/>

                        <TextBlock Text="网卡（留空则用 vnstat 的默认网卡）" FontSize="12"/>
                        <TextBox x:Name="InterfaceBox" Padding="4" Margin="0,3,0,3"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#777" Margin="0,0,0,8"
                                   Text="需要服务器上已安装并启用 vnstat，且本机能免密 SSH 登录（仅支持密钥认证）。详见 docs/setup-dmit.md。"/>
                    </StackPanel>

                    <TextBlock Text="月配额（GB，Vultr 填 0 表示自动采用 API 报告的值）" FontSize="12"/>
                    <TextBox x:Name="QuotaBox" Padding="4" Margin="0,3,0,8"/>

                    <TextBlock Text="计费口径" FontSize="12"/>
                    <ComboBox x:Name="MeterBox" Margin="0,3,0,8"/>

                    <TextBlock Text="GB 进制" FontSize="12"/>
                    <ComboBox x:Name="UnitBox" Margin="0,3,0,8"/>

                    <TextBlock Text="每月重置日" FontSize="12"/>
                    <ComboBox x:Name="ResetDayBox" Margin="0,3,0,3"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#777" Margin="0,0,0,10"
                               Text="配额在每月这一天归零。当月没有该日时（例如 31 号遇上 2 月）按当月最后一天处理。计费口径与进制填错会直接导致数字对不上服务商面板，首次配置后请用面板数值校准一次。"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Content="测试连接" Padding="12,5" Click="OnTestClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ConfigPathText" FontSize="11" Foreground="#999"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="保存并关闭" Padding="16,6" Click="OnSaveClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
