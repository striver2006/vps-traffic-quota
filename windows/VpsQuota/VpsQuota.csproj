<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 注意：UseWPF 的 XamlPreCompile 会生成一个临时项目（VpsQuota_*_wpftmp.csproj），
         它不继承 ImplicitUsings，隐式 global using 在那一轮编译里全部失效。
         所以 System.IO、System.Net.Http 这类命名空间必须在用到的文件里显式 using，
         否则本机 IDE 不报错、CI 上却会 CS0103/CS0246。 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon：WPF 自身没有托盘 API，
         而 NotifyIcon 是系统原生实现，比第三方库可靠。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VpsQuota</AssemblyName>
    <RootNamespace>VpsQuota</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- DPAPI（ProtectedData）在 .NET Core 之后不再内置于 BCL，需要这个包 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
